{
  "name": "@kwazou/openclaw-strava",
  "version": "0.2.0",
  "description": "Community Strava plugin for OpenClaw",
  "type": "module",
  "files": [
    "dist/index.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "0.34.52",
    "@types/node": "^25.5.0",
    "esbuild": "0.27.3",
    "openclaw": "2026.11.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@kwazou/openclaw-strava",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.11.1"
    },
    "compat": {
      "pluginApi": ">=2026.11.1",
      "minGatewayVersion": "2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1",
      "pluginSdkVersion": "2026.11.1"
    }
  }
}
